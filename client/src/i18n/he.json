    "avg_node_degree": {
      "label": "\u05d3\u05e8\u05d2\u05ea \u05e6\u05d5\u05de\u05ea \u05de\u05de\u05d5\u05e6\u05e2\u05ea",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05dc \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05d4\u05de\u05ea\u05d7\u05d1\u05e8\u05d9\u05dd \u05d1\u05db\u05dc \u05e6\u05d5\u05de\u05ea. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05e6\u05de\u05ea\u05d9\u05dd \u05de\u05d7\u05d5\u05d1\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8."
    },
    "circuity": {
      "label": "\u05e2\u05e7\u05d9\u05e4\u05d5\u05ea",
      "description": "\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05de\u05e8\u05d7\u05e7\u05d9 \u05d4\u05e0\u05e1\u05d9\u05e2\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc \u05dc\u05e7\u05d5 \u05d0\u05d5\u05d5\u05d9\u05e8\u05d9. \u05e2\u05e8\u05db\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d9\u05dd \u05dc-1 \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d9\u05dd; \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05de\u05e4\u05d5\u05ea\u05dc\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8."
    },
    "betweenness_centrality": {
      "label": "Betweenness Centrality",
      "description": "\u05de\u05d5\u05d3\u05d3 \u05db\u05de\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd \u05e6\u05d5\u05de\u05ea \u05e0\u05de\u05e6\u05d0 \u05e2\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e7\u05e6\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e6\u05de\u05ea\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05e7\u05e8\u05d9\u05d8\u05d9\u05d5\u05ea \u05e9\u05e0\u05d5\u05e9\u05d0\u05d5\u05ea \u05ea\u05e0\u05d5\u05e2\u05d4 \u05e8\u05d1\u05d4."
    },
    "avg_betweenness": {
      "label": "Avg Betweenness",
      "description": "Betweenness Centrality \u05de\u05de\u05d5\u05e6\u05e2 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05db\u05dc \u05d4\u05e6\u05de\u05ea\u05d9\u05dd. \u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05de\u05d9\u05d3\u05ea \u05d4\u05e4\u05d9\u05d6\u05d5\u05e8 \u05d4\u05e9\u05d5\u05d5\u05d4 \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05ea \u05d4\u05de\u05e2\u05d1\u05e8 \u05d1\u05e8\u05e9\u05ea."
    },
    "max_betweenness": {
      "label": "Max Betweenness",
      "description": "\u05e2\u05e8\u05da \u05d4-Betweenness Centrality \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e8\u05e9\u05ea \u2014 \u05d4\u05e6\u05d5\u05de\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05e0\u05d5\u05e2\u05ea \u05de\u05e2\u05d1\u05e8."
    },
    "closeness_centrality": {
      "label": "Closeness Centrality",
      "description": "\u05de\u05d5\u05d3\u05d3 \u05db\u05de\u05d4 \u05e7\u05e8\u05d5\u05d1 \u05e6\u05d5\u05de\u05ea \u05dc\u05db\u05dc \u05d4\u05e6\u05de\u05ea\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d9\u05dd \u05d3\u05e8\u05da \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e7\u05e6\u05e8\u05d9\u05dd. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05de\u05d9\u05e7\u05d5\u05de\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d5\u05e0\u05d2\u05d9\u05e9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8."
