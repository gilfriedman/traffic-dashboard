    "avg_node_connectivity": {
      "label": "\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05d5\u05ea \u05e6\u05de\u05ea\u05d9\u05dd \u05de\u05de\u05d5\u05e6\u05e2\u05ea",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05dc \u05e6\u05de\u05ea\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05d4\u05e1\u05d9\u05e8 \u05db\u05d3\u05d9 \u05dc\u05e0\u05ea\u05e7 \u05db\u05dc \u05d6\u05d5\u05d2 \u05e6\u05de\u05ea\u05d9\u05dd. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e8\u05e9\u05ea \u05e2\u05de\u05d9\u05d3\u05d4 \u05d9\u05d5\u05ea\u05e8."
    },
    "edge_connectivity": {
      "label": "\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05d5\u05ea \u05e7\u05e9\u05ea\u05d5\u05ea",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05e7\u05e9\u05ea\u05d5\u05ea (\u05db\u05d1\u05d9\u05e9\u05d9\u05dd) \u05e9\u05d9\u05e9 \u05dc\u05d4\u05e1\u05d9\u05e8 \u05db\u05d3\u05d9 \u05dc\u05e0\u05ea\u05e7 \u05d0\u05ea \u05d4\u05d2\u05e8\u05e3. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05e4\u05d7\u05d5\u05ea \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05db\u05e9\u05dc \u05d1\u05d5\u05d3\u05d3\u05d5\u05ea."
    },
    "exit_count": {
      "label": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05e6\u05d9\u05d0\u05d5\u05ea",
