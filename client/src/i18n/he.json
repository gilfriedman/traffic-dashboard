  "nodeClassification": {
    "interior": {
      "label": "\u05e4\u05e0\u05d9\u05dd",
      "description": "\u05e6\u05de\u05ea\u05d9\u05dd \u05d4\u05de\u05de\u05d5\u05e7\u05de\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d2\u05d1\u05d5\u05dc \u05d4\u05e9\u05db\u05d5\u05e0\u05d4, \u05de\u05d9\u05d9\u05e6\u05d2\u05d9\u05dd \u05e6\u05de\u05ea\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd."
    },
    "perimeter": {
      "label": "\u05d4\u05d9\u05e7\u05e3",
      "description": "\u05e6\u05de\u05ea\u05d9\u05dd \u05e2\u05dc \u05d0\u05d5 \u05dc\u05d9\u05d3 \u05d2\u05d1\u05d5\u05dc \u05d4\u05e9\u05db\u05d5\u05e0\u05d4, \u05dc\u05e8\u05d5\u05d1 \u05de\u05d7\u05d1\u05e8\u05d9\u05dd \u05dc\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05e1\u05de\u05d5\u05db\u05d9\u05dd."
    },
