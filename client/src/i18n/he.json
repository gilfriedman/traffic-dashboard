    },
    "total_street_length_m": {
      "label": "\u05d0\u05d5\u05e8\u05da \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc (\u05de\u05f3)",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d0\u05d5\u05e8\u05db\u05d9 \u05db\u05dc \u05de\u05e7\u05d8\u05e2\u05d9 \u05d4\u05db\u05d1\u05d9\u05e9 \u05d1\u05de\u05d8\u05e8\u05d9\u05dd."
