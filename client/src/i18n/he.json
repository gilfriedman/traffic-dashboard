    "rushHourProfile": "\u05d3\u05e4\u05d5\u05e1\u05d9 \u05e2\u05d5\u05de\u05e1 \u05d1\u05e9\u05e2\u05d5\u05ea \u05e9\u05d9\u05d0 \u05d1\u05d5\u05e7\u05e8 (6:00\u20139:00), \u05de\u05e4\u05d5\u05e8\u05d8\u05d9\u05dd \u05dc\u05de\u05e8\u05d5\u05d5\u05d7\u05d9\u05dd \u05e9\u05dc 15 \u05d3\u05e7\u05d5\u05ea.",
    "congestionOverTimeDaily": "\u05de\u05d2\u05de\u05d4 \u05d9\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05d9\u05d7\u05e1\u05d9 \u05e2\u05d5\u05de\u05e1 \u05de\u05de\u05d5\u05e6\u05e2\u05d9\u05dd. \u05e2\u05d5\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05ea\u05e0\u05d0\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05ea\u05e7\u05d5\u05e4\u05ea \u05d0\u05d9\u05e1\u05d5\u05e3 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd.",
    "timeSeries": "\u05de\u05d2\u05de\u05d5\u05ea \u05e2\u05d5\u05de\u05e1 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df \u05e2\u05dd \u05e8\u05d6\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05de\u05ea\u05db\u05d5\u05d5\u05e0\u05ea (15 \u05d3\u05e7\u05d5\u05ea, \u05e9\u05e2\u05ea\u05d9\u05ea, \u05d9\u05d5\u05de\u05d9\u05ea, \u05e9\u05d1\u05d5\u05e2\u05d9\u05ea).",
    "dayOfWeek": "\u05e2\u05d5\u05de\u05e1 \u05de\u05de\u05d5\u05e6\u05e2 \u05dc\u05db\u05dc \u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2. \u05d7\u05d5\u05e9\u05e3 \u05d3\u05e4\u05d5\u05e1\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd.",
    "rushHourCharts": "\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e2\u05d5\u05de\u05e1 \u05d9\u05d5\u05de\u05d9 \u05d4\u05de\u05e8\u05d0\u05d4 \u05db\u05d9\u05e6\u05d3 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d9\u05d5\u05dd.",
    "routeRanking": "\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05de\u05d3\u05d5\u05e8\u05d2\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d9\u05d7\u05e1 \u05e2\u05d5\u05de\u05e1 \u05de\u05de\u05d5\u05e6\u05e2. \u05de\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e2\u05de\u05d5\u05e1\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8.",
    "distribution": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05d2\u05e8\u05de\u05d4 \u05d4\u05de\u05e8\u05d0\u05d4 \u05db\u05d9\u05e6\u05d3 \u05e2\u05e8\u05db\u05d9 \u05d9\u05d7\u05e1 \u05d4\u05e2\u05d5\u05de\u05e1 \u05de\u05ea\u05e4\u05dc\u05d2\u05d9\u05dd \u05e2\u05dc \u05e4\u05e0\u05d9 \u05db\u05dc \u05d4\u05de\u05d3\u05d9\u05d3\u05d5\u05ea.",
    "networkOverview": "\u05de\u05d3\u05d3\u05d9 \u05e8\u05e9\u05ea \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05dc\u05db\u05dc \u05e9\u05db\u05d5\u05e0\u05d4, \u05de\u05d7\u05d5\u05e9\u05d1\u05d9\u05dd \u05de\u05e0\u05ea\u05d5\u05e0\u05d9 OpenStreetMap \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea OSMnx.",
    "congestionStructure": "\u05d2\u05e8\u05e3 \u05e4\u05d9\u05d6\u05d5\u05e8 \u05d4\u05d7\u05d5\u05e7\u05e8 \u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05de\u05d3\u05d3\u05d9 \u05de\u05d1\u05e0\u05d4 \u05e8\u05e9\u05ea \u05d4\u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05dc\u05e8\u05de\u05d5\u05ea \u05e2\u05d5\u05de\u05e1. \u05db\u05dc \u05e0\u05e7\u05d5\u05d3\u05d4 \u05de\u05d9\u05d9\u05e6\u05d2\u05ea \u05e9\u05db\u05d5\u05e0\u05d4.",
    "exitAnalysis": "\u05d9\u05e6\u05d9\u05d0\u05d5\u05ea \u05e9\u05db\u05d5\u05e0\u05d5\u05ea \u05de\u05d5\u05ea\u05d0\u05de\u05d5\u05ea \u05dc\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05e1\u05de\u05d5\u05db\u05d9\u05dd, \u05de\u05d3\u05d5\u05e8\u05d2\u05d5\u05ea \u05dc\u05e4\u05d9 \u05e2\u05d5\u05de\u05e1 \u05de\u05de\u05d5\u05e6\u05e2.",
    "bottlenecks": "\u05e6\u05de\u05ea\u05d9\u05dd \u05d1\u05e2\u05dc\u05d9 \u05e8\u05de\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05d9\u05d3 \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e2\u05de\u05d5\u05e1\u05d9\u05dd. \u05e6\u05d9\u05d5\u05df = betweenness \u00d7 \u05e2\u05d5\u05de\u05e1 \u05e1\u05de\u05d5\u05da.",
    "networkGraph": "\u05e8\u05e9\u05ea \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05ea \u05dc\u05db\u05dc \u05e9\u05db\u05d5\u05e0\u05d4. \u05db\u05d7\u05d5\u05dc = \u05e6\u05de\u05ea\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd, \u05db\u05ea\u05d5\u05dd = \u05e6\u05de\u05ea\u05d9\u05dd \u05d4\u05d9\u05e7\u05e4\u05d9\u05d9\u05dd, \u05d0\u05e4\u05d5\u05e8 = \u05e6\u05de\u05ea\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd, \u05d7\u05d9\u05e6\u05d9\u05dd \u05d9\u05e8\u05d5\u05e7\u05d9\u05dd = \u05d9\u05e6\u05d9\u05d0\u05d5\u05ea. \u05e7\u05d5 \u05d0\u05d3\u05d5\u05dd = \u05d2\u05d1\u05d5\u05dc \u05d4\u05e9\u05db\u05d5\u05e0\u05d4."
  },
  "metrics": {
    "node_count": {
