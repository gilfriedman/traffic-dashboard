      "description": "\u05d0\u05d5\u05e8\u05da \u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05dc \u05de\u05e7\u05d8\u05e2 \u05db\u05d1\u05d9\u05e9 \u05d1\u05d5\u05d3\u05d3 \u05d1\u05de\u05d8\u05e8\u05d9\u05dd."
    },
    "intersection_count": {
      "label": "\u05de\u05e1\u05e4\u05e8 \u05e6\u05de\u05ea\u05d9 \u05d3\u05e8\u05db\u05d9\u05dd",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e6\u05de\u05ea\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05e0\u05e4\u05d2\u05e9\u05d9\u05dd 3 \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 (\u05e6\u05de\u05ea\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd, \u05dc\u05d0 \u05de\u05d1\u05d5\u05d9 \u05e1\u05ea\u05d5\u05de\u05d9\u05dd)."
    },
    "intersection_density_per_km2": {
      "label": "\u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05e6\u05de\u05ea\u05d9\u05dd \u05dc\u05e7\u05de\u05f4\u05e8",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e6\u05de\u05ea\u05d9\u05dd \u05dc\u05db\u05dc \u05e7\u05d9\u05dc\u05d5\u05de\u05d8\u05e8 \u05e8\u05d1\u05d5\u05e2. \u05e2\u05e8\u05db\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e8\u05e9\u05ea \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05e6\u05e4\u05d5\u05e4\u05d4 \u05d9\u05d5\u05ea\u05e8."
    },
    "street_density_m_per_km2": {
      "label": "\u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05db\u05d1\u05d9\u05e9\u05d9\u05dd (\u05de/\u05e7\u05de\u05f4\u05e8)",
      "description": "\u05d0\u05d5\u05e8\u05da \u05db\u05d1\u05d9\u05e9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc \u05d1\u05de\u05d8\u05e8\u05d9\u05dd \u05dc\u05db\u05dc \u05e7\u05d9\u05dc\u05d5\u05de\u05d8\u05e8 \u05e8\u05d1\u05d5\u05e2 \u05e9\u05dc \u05e9\u05d8\u05d7 \u05d4\u05e9\u05db\u05d5\u05e0\u05d4."
